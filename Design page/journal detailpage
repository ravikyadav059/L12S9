                        <button type="button" class="disclaimer-close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">Close</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        $('.claimJournalBtn').on('click', function () {

            let journalId = $(this).data('journal-id');

            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to submit a claim for this journal?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Claim It',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33'
            }).then((result) => {

                if (result.isConfirmed) {
                    $.ajax({
                        url: "{{ route('claim.journal', ':id') }}".replace(':id', journalId),

                        type: "POST",
                        data: {
                            _token: "{{ csrf_token() }}"
                        },
                        beforeSend: function () {
                            Swal.fire({
                                title: 'Submitting...',
                                text: 'Please wait',
                                allowOutsideClick: false,
                                didOpen: () => {
                                    Swal.showLoading();
                                }
                            });
                        },
                        success: function (res) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: res.message
                            }).then(() => {
                                location.reload(); // optional
                            });
                        },
                        error: function (xhr) {
                            let msg = 'Something went wrong';

                            if (xhr.responseJSON && xhr.responseJSON.message) {
                                msg = xhr.responseJSON.message;
                            }

                            // User not logged in
                            if (xhr.status === 401) {

                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Login Required',
                                    text: msg,
                                    showCancelButton: true,
                                    confirmButtonText: 'Login',
                                    cancelButtonText: 'OK',
                                }).then((result) => {

                                    if (result.isConfirmed) {
                                        window.location.href = "{{ route('publisher_login') }}";
                                    }

                                });

                            }

                            // Publisher profile not created
                            else if (xhr.status === 403) {

                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Publisher Registration Required',
                                    text: msg,
                                    showCancelButton: true,
                                    confirmButtonText: 'Register',
                                    cancelButtonText: 'OK',
                                }).then((result) => {

                                    if (result.isConfirmed) {
                                        window.location.href = "{{ route('publisher_register') }}";
                                    }

                                });

                            }

                            // All other errors
                            else {

                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: msg
                                });

                            }
                        }
                    });

                }

            });

        });

        // For View More Tags 
        document.addEventListener('DOMContentLoaded', function () {
            var moreBtn = document.getElementById('moreBtn');

            if (moreBtn) {
                moreBtn.addEventListener('click', function () {

                    var hiddenItems = document.querySelectorAll('.nj-tag.hidden');

                    hiddenItems.forEach(function (item) {
                        item.classList.remove('hidden');
                    });

                    this.style.display = 'none';
                });
            }
        });

    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const btn = document.getElementById('showMoreBtn');
            const grid = document.getElementById('njIndexingGrid');

            if (!btn || !grid) return;

            btn.addEventListener('click', function () {
                const hiddenItems = grid.querySelectorAll('.nj-index-item.hidden');
                if (hiddenItems.length > 0) {
                    // Show the next hidden item
                    hiddenItems[0].classList.remove('hidden');

                    // Update button text
                    const remaining = hiddenItems.length - 1;
                    if (remaining > 0) {
                        btn.textContent = `+${remaining} More`;
                    } else {
                        btn.style.display = 'none';
                    }
                }
            });
        });
    </script>

@endsection