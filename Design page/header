<script>
    function toggleMobileMenu() {
        const overlay = document.getElementById('mobileMenuOverlay');
        overlay.classList.toggle('active');
        document.body.style.overflow = overlay.classList.contains('active') ? 'hidden' : '';
    }

    function toggleMobileSearch() {
        const overlay = document.getElementById('mobileSearchOverlay');
        overlay.classList.toggle('active');
        document.body.style.overflow = overlay.classList.contains('active') ? 'hidden' : '';
        
        if (overlay.classList.contains('active')) {
            // Opening - focus on input
            setTimeout(() => overlay.querySelector('.mobile-search-input').focus(), 100);
        } else {
            // Closing - clear input and results
            const input = overlay.querySelector('.mobile-search-input');
            const results = document.getElementById('mobile-search-results');
            if (input) input.value = '';
            if (results) {
                results.innerHTML = '';
                results.style.display = 'none';
            }
        }
    }

    function toggleSubmenu(element) {
        element.classList.toggle('active');
        const submenu = element.nextElementSibling;
        submenu.classList.toggle('active');
    }

    document.addEventListener('click', function (e) {
        const mobileMenuOverlay = document.getElementById('mobileMenuOverlay');
        const hamburgerBtn = document.querySelector('.hamburger-btn');
        if (mobileMenuOverlay?.classList.contains('active') && !mobileMenuOverlay.contains(e.target) && !hamburgerBtn.contains(e.target)) {
            toggleMobileMenu();
        }
    });

    document.getElementById('mobileSearchOverlay')?.addEventListener('click', function (e) {
        if (e.target === this) toggleMobileSearch();
    });

    function handleApplyVerification(emailVerifiedAt) {
        if (!emailVerifiedAt || emailVerifiedAt === '') {
            document.getElementById('emailVerificationModal').classList.add('active');
        } else {
            document.getElementById('accountVerificationConfirmModal').classList.add('active');
        }
    }

    function closeVerificationModals() {
        document.getElementById('emailVerificationModal').classList.remove('active');
        document.getElementById('accountVerificationConfirmModal').classList.remove('active');
        document.getElementById('incompleteProfileModal').classList.remove('active');
    }

    function submitAccountVerification() {
        const btn = document.getElementById('btnSubmitVerification');
        const originalText = btn.innerHTML;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';
        btn.disabled = true;

        fetch('{{ route('apply.verification.request') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-TOKEN': '{{ csrf_token() }}'
            }
        })
        .then(response => response.json())
        .then(data => {
            closeVerificationModals();
            if(data.success) {
                alert('Verification request sent successfully!');
            } else {
                if (data.missing_fields && data.missing_fields.length > 0) {
                    // Use full checklist if available, otherwise fall back to missing-only
                    const fields = data.all_fields || data.missing_fields.map(f => ({ label: f, done: false, optional: false }));
                    const listHtml = fields.map(f => {
                        if (f.done) {
                            // Completed — green strikethrough
                            return `<li style="display:flex;align-items:center;gap:8px;padding:5px 0;color:#16a34a;text-decoration:line-through;opacity:0.7;">
                                        <span style="flex-shrink:0;width:18px;height:18px;border-radius:50%;background:#dcfce7;display:inline-flex;align-items:center;justify-content:center;font-size:11px;color:#16a34a;">✓</span>
                                        ${f.label}
                                    </li>`;
                        } else if (f.optional) {
                            // Optional & unfilled — amber badge, italic, not blocking
                            return `<li style="display:flex;align-items:center;gap:8px;padding:5px 0;color:#92400e;font-style:italic;">
                                        <span style="flex-shrink:0;width:18px;height:18px;border-radius:50%;background:#fef3c7;display:inline-flex;align-items:center;justify-content:center;font-size:11px;color:#d97706;">○</span>
                                        ${f.label}
                                    </li>`;
                        } else {
                            // Required & missing — red bold
                            return `<li style="display:flex;align-items:center;gap:8px;padding:5px 0;color:#dc2626;font-weight:600;">
                                        <span style="flex-shrink:0;width:18px;height:18px;border-radius:50%;background:#fee2e2;display:inline-flex;align-items:center;justify-content:center;font-size:11px;color:#dc2626;">✕</span>
                                        ${f.label}
                                    </li>`;
                        }
                    }).join('');
                    document.getElementById('incompleteProfileList').innerHTML = listHtml;
                    document.getElementById('incompleteProfileModal').classList.add('active');
                } else {
                    alert('Failed to send request: ' + (data.message || 'Unknown error'));
                }
            }
        })
        .catch(error => {
            console.error('Error:', error);
            closeVerificationModals();
            alert('An error occurred while sending the request.');
        })
        .finally(() => {
            btn.innerHTML = originalText;
            btn.disabled = false;
        });
    }

</script>
