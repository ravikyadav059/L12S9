    }

    .main-inner-change-container:hover::before {
        opacity: 1;
    }

    .main-inner-change-container.unread {
        background: linear-gradient(135deg, #f0f7ff 0%, #e6f2ff 100%);
        border: 2px solid #198BEA;
        border-left: 4px solid #198BEA;
    }

