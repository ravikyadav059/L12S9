                if ($field.hasClass("author-affiliation") || $field.attr("name").startsWith("author_affiliation_")) {
                    return; // Skip this field
                }

                if (!$field.val().trim() && !firstEmptyField) {
                    $field.css("border", "2px solid red");
                    firstEmptyField = this;

                    setTimeout(function () {
                        $field.css("border", ""); // Remove the red border after 2 seconds
                    }, 2000);
                    return false; // Break loop
                } else {
                    $field.css("border", "");
                }
            });

            if (firstEmptyField) {
                $(firstEmptyField).focus();
