<script>
    $(function () {
        $('#publication_month_year').datepicker({
            changeMonth: true,
            changeYear: true,
            showButtonPanel: true,
            dateFormat: 'MM yy',
            yearRange: '1700:+nn',
            beforeShow: function (input, inst) {
                // Hide calendar dates (show only month-year)
                $(".ui-datepicker-calendar").hide();
            },
            onClose: function (dateText, inst) {
                var month = $("#ui-datepicker-div .ui-datepicker-month :selected").val();
                var year = $("#ui-datepicker-div .ui-datepicker-year :selected").val();

                // Check if month/year are selected
                if (month !== null && year !== null) {
                    $(this).val($.datepicker.formatDate('MM yy', new Date(year, month, 1)));
                }
            }
        });

        // When user focuses the input again, hide dates
        $("#publication_month_year").focus(function () {
            $(".ui-datepicker-calendar").hide();
        });
    });
</script>
<script>
    function checkJournalName(journalIdOrName) {
        if (journalIdOrName.trim().length > 0) {
            $.ajax({
                url: "{{ route('check.journal') }}", // Match your route name
                method: "POST",
                data: {
                    _token: '{{ csrf_token() }}',
                    value: journalIdOrName // Sending input
                },
                success: function (response) {
                    if (response.exists) {
                        $('#journal-check-icon').show();

                        if (response.journal_id) {
                            $('#article_search_journal_id').val(response.journal_id);
                        }
                    } else {
                        $('#journal-check-icon').hide();
                        $('#article_search_journal_id').val('');
                    }
                }
            });
        } else {
            $('#journal-check-icon').hide();
            $('#article_search_journal_id').val('');
        }
    }
    checkJournalName("");

    $(document).ready(function () {
        $('#article_search_journal').on('input', function () {
            const journalIdOrName = $(this).val();
            checkJournalName(journalIdOrName);
        });
    });

