<script>

    $(document).on('input change', '.author-email-input', function () {
        let currentEmail = $(this).val().trim();
        let $currentInput = $(this);
        let isDuplicate = false;

        $(".author-email-input").not($currentInput).each(function () {
            if ($(this).val().trim() === currentEmail && currentEmail !== "") {
                isDuplicate = true;
                return false; // Break the loop
            }
        });

        if (isDuplicate) {
            alert("This email is already assigned to another author.");
            $currentInput.val(''); // Clear the duplicate input
        }
    });

</script>
