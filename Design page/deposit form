<!-- JavaScript to handle adding keywords dynamically -->

<script>
    let keywords = [];
    document.addEventListener("DOMContentLoaded", function () {
        const container = document.getElementById("keyword-input");
        const hiddenInput = document.getElementById("keywords-hidden");
        const errorMessage = document.getElementById("keyword-error");

        // When container is clicked, focus the editable area
        container.addEventListener("click", function (e) {
            const editable = document.getElementById("editable-area");
            if (!e.target.classList.contains("keyword-tag") && !e.target.classList.contains("remove-tag")) {
                editable.focus();
            }
        });

        // Function to re-render the container with tags and an editable area
        function updateInput() {
            container.innerHTML = "";
            keywords.forEach(keyword => {
                let tag = document.createElement("span");
                tag.className = "keyword-tag";
                tag.textContent = keyword;
                tag.style.marginRight = "5px";
                tag.style.padding = "2px 5px";
                tag.style.backgroundColor = "#e0e0e0";
                tag.style.borderRadius = "3px";

                let removeBtn = document.createElement("span");
                removeBtn.textContent = " ×";
                removeBtn.style.cursor = "pointer";
                removeBtn.style.color = "red";
                removeBtn.style.fontSize = "16px";
                removeBtn.addEventListener("click", function (e) {
                    e.stopPropagation();
                    keywords = keywords.filter(k => k !== keyword);
                    updateInput();
                });
                tag.appendChild(removeBtn);
                container.appendChild(tag);
            });

            // Create a new editable area for new input with a placeholder
            const newEditable = document.createElement("span");
            newEditable.id = "editable-area";
            newEditable.className = "editable-area";
            newEditable.contentEditable = "true";
            newEditable.style.outline = "none";
            newEditable.style.color = "#888"; // Placeholder color
            newEditable.innerHTML = "Enter the Key Word";

            // Remove placeholder on focus
            newEditable.addEventListener("focus", function () {
                if (newEditable.textContent.trim() === "Enter the Key Word") {
                    newEditable.textContent = "";
                    newEditable.style.color = "#000"; // Normal text color
                }
            });

            // Add placeholder if empty on blur
            newEditable.addEventListener("blur", function () {
                if (newEditable.textContent.trim() === "") {
                    //   newEditable.textContent = "Enter the Key Word";
                    newEditable.style.color = "#888"; // Placeholder color
                }
            });

            container.appendChild(newEditable);
            newEditable.focus();

            // Update hidden input
            hiddenInput.value = keywords.join(",");
        }

        // Process text from the editable area when Enter or Tab is pressed
        function processCurrentText() {
            const editable = document.getElementById("editable-area");
            let text = editable.textContent.trim();
            if (text && text !== "Enter the Key Word") {
                let newKeywords = text.split(/,\s*/).map(k => k.trim().toLowerCase()).filter(k => k);
                newKeywords.forEach(keyword => {
                    if (!keywords.includes(keyword)) {
                        keywords.push(keyword);
                    } else {
                        errorMessage.textContent = "This keyword is already added!";
                        setTimeout(() => { errorMessage.textContent = ""; }, 2000);
                    }
                });
                updateInput();
            }
        }

        // Listen for keydown events in the container (using event delegation)
        container.addEventListener("keydown", function (e) {
            const editable = document.getElementById("editable-area");
            // If Backspace is pressed and editable area is empty, remove the last tag
            if (e.key === "Backspace") {
                if (editable.textContent.trim() === "") {
                    if (keywords.length > 0) {
                        keywords.pop();
                        updateInput();
                    }
                    e.preventDefault();
                    return;
                }
            }
            // Process Enter or Tab key to add new keywords
            if (e.key === "Enter" || e.key === "Tab") {
                e.preventDefault();
                processCurrentText();
            }
        });

        // Listen for paste events in the container on the editable area
        container.addEventListener("paste", function (e) {
            const target = e.target;
            if (target.id === "editable-area") {
                e.preventDefault();
                let pastedText = (e.clipboardData || window.clipboardData).getData("text");
                if (pastedText) {
                    let newKeywords = pastedText.split(/,\s*/).map(k => k.trim().toLowerCase()).filter(k => k);
                    newKeywords.forEach(keyword => {
                        if (!keywords.includes(keyword)) {
                            keywords.push(keyword);
                        } else {
                            errorMessage.textContent = "This keyword is already added!";
                            setTimeout(() => { errorMessage.textContent = ""; }, 2000);
                        }
                    });
                    updateInput();
                }
            }
        });
    });
</script>



