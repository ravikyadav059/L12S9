    public function reviewerProfile()
    {
        return $this->hasOne(ReviewerProfile::class, 'user_id', '_id');
    }


    public function reviewerDetails()
    {
        return $this->hasMany(ReviewerDetails::class, 'reviewer_id', '_id');
    }


    public function sendEmailVerificationNotification()
    {
        $this->forceFill([
            'verification_token' => Str::random(64),
        ])->save();

        $this->notify(new CustomVerifyEmail($this->verification_token));
    }

    public function country()
    {
        return $this->belongsTo(Country::class, 'publisher_country', 'id');
    }

    public function state()
    {
