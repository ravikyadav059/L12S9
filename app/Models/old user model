    }

    public function city()
    {
        return $this->belongsTo(City::class, 'publisher_city', 'id');
    }

    
    // Created by Tony 10/02/2026 this is under Testing version.

public function getAvatarAttribute()
{
    $name = trim($this->first_name . ' ' . $this->last_name);

    if ($this->photo) {
        if (Str::startsWith($this->photo, ['http://', 'https://'])) {
            return $this->photo; // External URL, return directly
        } else {
            $photoPath = public_path($this->photo); // Full file path on server

            if (file_exists($photoPath) && is_file($photoPath)) {
                return asset($this->photo); // File exists, return URL
            }
            // File doesn't exist, fall back to avatar below
        }
    }

    // Default avatar if no photo or file missing
    return 'https://ui-avatars.com/api/?name='
        . urlencode($name ?: 'User')
        . '&background=198BEA&color=fff';
}

