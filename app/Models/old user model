    /**
     * Interact with the user's first name.
     *
     * @param  string  $value
     * @return \Illuminate\Database\Eloquent\Casts\Attribute
     */
    protected function type(): Attribute
    {
        // return new Attribute(
        //     get: fn ($value) =>  ["user", "admin"][$value],
        // );
        return new Attribute(
            get: fn($value) => isset($value) && array_key_exists($value, ["user", "admin"])
            ? ["user", "admin"][$value]
            : null, // Default to null if `$value` is missing or invalid
        );
    }

    protected function status(): Attribute
    {
        return new Attribute(
            get: fn($value) => ["Pending", "Active", "Re-Document", "Reject"][$value] ?? 'Unknown',
        );
    }

    protected function verified(): Attribute
    {
        return new Attribute(
            get: fn($value) => ["Pending", "Active"][$value] ?? 'Unknown',
        );
    }

    public function educationCategory()
